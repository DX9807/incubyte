# Local development only. Generate a secret using the command in README.md.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY=false
# Enable only when every subdomain is permanently HTTPS.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
# Gunicorn reads these from the process environment.
PORT=8000
WEB_CONCURRENCY=2
PGDATABASE=acme_salary
PGUSER=acme
PGPASSWORD=
PGHOST=127.0.0.1
PGPORT=5432
PGSSLMODE=prefer
